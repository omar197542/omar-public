        "from dataclasses import dataclass\n",
        "\n",
        "\n",
        "@dataclass\n",
        "class Record:\n",
        "    date: str\n",
        "    category: str\n",
        "    amount_egp: float\n",
        "    payment_method: str\n",
        "    record_id: int\n",
        "\n",
        "\n",
        "class Tracker:\n",
        "    def __init__(self):\n",
        "        self.records = []\n",
        "\n",
        "    def add(self, record):\n",
        "        self.records.append(record)\n",
        "\n",
        "    def top_n(self, field, n):\n",
        "        \"\"\"Return the n records with the biggest value of field.\"\"\"\n",
        "        return sorted(\n",
        "            self.records,\n",
        "            key=lambda record: getattr(record, field),\n",
        "            reverse=True\n",
        "        )[:n]\n",
        "\n",
        "\n",
        "# Test\n",
        "sample = Tracker()\n",
        "\n",
        "sample.add(Record(\"2026-10-01\", \"food\", 85.5, \"cash\", 1))\n",
        "sample.add(Record(\"2026-10-02\", \"drink\", 40.0, \"card\", 2))\n",
        "sample.add(Record(\"2026-10-03\", \"bills\", 300.0, \"card\", 1))\n",
        "\n",
        "top = sample.top_n(\"amount_egp\", 2)\n",
        "\n",
        "assert len(top) == 2, \"top 2\"\n",
        "assert top[0].amount_egp == 300.0, \"أكبر مبلغ\"\n",
        "assert top[1].amount_egp == 85.5, \"المبلغ الثاني\"\n",
        "\n",
        "big = sample.top_n(\"amount_egp\", 99)\n",
        "\n",
        "assert big[0].amount_egp == 300.0, \"أكبر مبلغ من n\"\n",
        "print(\"Part C: ﻣﻤﺘﺎز\")"
      ]
    }
