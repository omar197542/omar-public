        "\n",
        "class Classroom:\n",
        "    def __init__(self, room):\n",
        "        # اسم القاعة + قائمة الطلاب\n",
        "        self.room = room\n",
        "        self.students = []\n",
        "\n",
        "    def add(self, student):\n",
        "        # ضيف الطالب لقائمة الطلاب\n",
        "        self.students.append(student)\n",
        "\n",
        "    def best(self):\n",
        "        # رجّع الطالب الأعلى بمتوسط الدرجات\n",
        "        if not self.students:\n",
        "            return None\n",
        "\n",
        "        return max(self.students, key=lambda student: student.average())\n",
        "\n",
        "\n",
        "# إنشاء قاعة وإضافة طالب\n",
