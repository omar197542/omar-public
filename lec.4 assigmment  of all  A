        "def is_even(n):\n",
        "    return n % 2 == 0\n",
        "\n",
        "def square(n):\n",
        "    return n * n\n",
        "\n",
        "def average(values):\n",
        "    return sum(values) / len(values)\n",
        "\n",
        "print(is_even(4), square(7))\n",
        "\n",
        "\n",
        "\n",
        "assert is_even(4) == True and is_even(7) == False, \"is_even\"\n",
        "assert square(7) == 49, \"square\"\n",
        "assert abs(average([80, 90, 76]) - 82) < 0.01, \"average\"\n",
        "\n",
        "print(\"A1: تمام\")\n",
        "\n"
      ]
