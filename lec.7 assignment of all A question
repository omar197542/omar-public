        "import os\n",
        "import pandas as pd\n",
        "\n",
        "\n",
        "os.makedirs(\"data\", exist_ok=True)\n",
        "\n",
        "coffee = [\n",
        "    {\"day\": \"Mon\", \"drink\": \"espresso\", \"cups\": 12, \"revenue\": 36.0},\n",
        "    {\"day\": \"Mon\", \"drink\": \"latte\", \"cups\": 18, \"revenue\": 90.0},\n",
        "    {\"day\": \"Tue\", \"drink\": \"espresso\", \"cups\": 10, \"revenue\": 30.0},\n",
        "    {\"day\": \"Tue\", \"drink\": \"latte\", \"cups\": 22, \"revenue\": 110.0},\n",
        "    {\"day\": \"Wed\", \"drink\": \"espresso\", \"cups\": 14, \"revenue\": 42.0},\n",
        "    {\"day\": \"Wed\", \"drink\": \"tea\", \"cups\": 9, \"revenue\": 27.0},\n",
        "    {\"day\": \"Thu\", \"drink\": \"latte\", \"cups\": 20, \"revenue\": 100.0},\n",
        "    {\"day\": \"Fri\", \"drink\": \"espresso\", \"cups\": 16, \"revenue\": 48.0},\n",
        "    {\"day\": \"Fri\", \"drink\": \"latte\", \"cups\": 25, \"revenue\": 125.0},\n",
        "    {\"day\": \"Sat\", \"drink\": \"latte\", \"cups\": 30, \"revenue\": 150.0},\n",
        "    {\"day\": \"Sat\", \"drink\": \"tea\", \"cups\": 12, \"revenue\": 36.0},\n",
        "]\n",
        "\n",
        "pd.DataFrame(coffee).to_csv(\"data/coffee_demo.csv\", index=False)\n",
        "\n",
        "\n",
        "df = pd.read_csv(\"data/coffee_demo.csv\")\n",
        "\n",
        "\n",
        "print(\"DataFrame shape:\", df.shape)\n",
