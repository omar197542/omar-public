        "import numpy as np\n",
        "\n",
        "x = np.array([12.0, 18.0, 9.0, 21.0, 15.0])\n",
        "\n",
        "\n",
        "norm = (x - np.mean(x)) / np.std(x)\n",
        "\n",
        "print(round(norm.mean(), 6))\n",
        "print(round(norm.std(), 6))\n",
        "\n",
        "\n",
        "m = np.array([[1, 2, 3],\n",
        "              [4, 5, 6]])\n",
        "\n",
        "print(m.shape)\n",
        "print(m.mean(axis=0))\n",
        "print(m.mean(axis=1))\n",
        "\n",
        "\n",
        "assert abs(norm.mean()) < 1e-9, \"المتوسط يجب أن يكون صفرًا\"\n",
        "assert abs(norm.std() - 1.0) < 1e-9, \"الانحراف المعياري يجب أن يساوي 1\"\n",
        "assert m.sum() == 21 and m.shape == (2, 3)\n",
        "\n",
        "\n",
        "print(\"A1: ﻣﻤﺘﺎز\")"
      ]
    },
